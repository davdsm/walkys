# PocketBase API URL (optional; default: http://127.0.0.1:8090)
# VITE_API_ENDPOINT=http://127.0.0.1:8090

# Backoffice users list: use PocketBase *Admin* (dashboard) credentials so the app
# can list all users. Must be the login for http://localhost:8090/_/ (PocketBase Admin),
# NOT a user from the "users" collection. Vite only exposes vars with API_ or VITE_ prefix.
API_PB_ADMIN_EMAIL=your-pocketbase-admin@example.com
API_PB_ADMIN_PASSWORD=your-pocketbase-admin-password

# Admin email for notifications (new order, new message, new user). Defaults to API_PB_ADMIN_EMAIL if not set.
# ADMIN_EMAIL=admin@yourdomain.com

# SMTP (cPanel / próprio domínio) – envio de emails transacionais
# SMTP_HOST=mail.phfconcept.com
# SMTP_PORT=465
# SMTP_USER=geral@phfconcept.com
# SMTP_PASS=senha-da-conta-email

# Endereço "De" nos emails enviados (ex: Walkys <geral@phfconcept.com>)
# EMAIL_FROM=Walkys <geral@phfconcept.com>

# URL pública da app para links nos emails (ex: https://walkys.pt)
# PUBLIC_APP_URL=https://walkys.pt
